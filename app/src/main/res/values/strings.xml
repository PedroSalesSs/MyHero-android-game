    <!-- Bestiário: janela aberta pelo botão "?" da escolha do inimigo.
         Os textos com <b> e <font> ficam dentro de CDATA porque passam pelo
         getString (que preenche os números) e depois pelo HtmlCompat (que aplica o estilo). -->
    <string name="titulo_bestiario">Bestiário</string>
    <string name="voltar">Voltar</string>
    <string name="regras_titulo">Como o combate funciona</string>
    <!-- %1$d e %2$d = dano do Ataque Leve, %3$d = vida do herói -->
    <string name="regra_ataque"><![CDATA[Seu Ataque Leve causa <b>%1$d–%2$d</b> de dano. Você tem <b>%3$d</b> de vida.]]></string>
    <!-- %1$d = chance de o inimigo preparar o golpe -->
    <string name="regra_preparo"><![CDATA[Todo inimigo tem <b>%1$d%%</b> de chance por turno de <b>preparar</b> um golpe especial. A tela brilha <font color="#C45A00">laranja</font> e ele avisa: o golpe sai no próximo turno.]]></string>
    <!-- %1$d = quanto a defesa reduz, %2$d = chance de bloqueio perfeito, %3$d e %4$d = dano do contra-ataque -->
    <string name="regra_defesa"><![CDATA[<b>Defender</b> reduz o golpe em <b>%1$d%%</b> e tem <b>%2$d%%</b> de chance de <b>Bloqueio Perfeito</b>: dano zero e você contra-ataca (%3$d–%4$d).]]></string>
    <string name="regra_defesa_turno"><![CDATA[A defesa vale só para o turno seguinte do inimigo — defender enquanto ele <i>prepara</i> não adianta.]]></string>
    <!-- %1$d = usos do Ataque Pesado, %2$d = chance de triplo, %3$d = usos da poção, %4$d = cura -->
    <string name="regra_especiais"><![CDATA[<b>Ataque Pesado</b> (%1$d×): concentra um turno, depois causa o dobro (%2$d%% de chance de triplo). <b>Poção</b> (%3$d×): +%4$d de vida sem gastar o turno.]]></string>

