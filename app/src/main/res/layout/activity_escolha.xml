<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_pedra_repetido"
    tools:context=".EscolhaActivity">

    <!-- Nome do jogo numa faixa de madeira: as bandeirolas ficam atrás
         e a placa com o nome, por cima, cobrindo o meio delas -->
    <FrameLayout
        android:id="@+id/faixaTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/ic_bandeirolas"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/txtNomeJogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="40dp"
            android:paddingHorizontal="36dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_placa_titulo"
            android:text="@string/titulo_jogo"
            android:fontFamily="@font/medieval"
            android:textColor="@color/dourado"
            android:textSize="60sp"
            android:shadowColor="#000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="4" />
    </FrameLayout>

    <!-- Instrução numa placa de madeira, como um letreiro.
         Segurar o dedo sobre ela abre os créditos. -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:paddingHorizontal="28dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_madeira"
        android:text="@string/titulo_escolha"
        android:fontFamily="@font/medieval"
        android:textColor="@color/pergaminho"
        android:textSize="28sp"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="3"
        app:layout_constraintTop_toBottomOf="@id/faixaTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- As duas opções lado a lado, centralizadas no espaço abaixo do subtítulo -->
    <LinearLayout
        android:id="@+id/painelOpcoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintBottom_toTopOf="@id/txtAssinatura"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Cartão: masculino (moldura de madeira) -->
        <LinearLayout
            android:id="@+id/cardMasculino"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_moldura"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgMasculino"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:contentDescription="@string/opcao_masculino" />

            <!-- Nome numa faixa de pergaminho -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingVertical="6dp"
                android:gravity="center"
                android:background="@drawable/bg_pergaminho"
                android:text="@string/opcao_masculino"
                android:fontFamily="@font/medieval"
                android:textColor="@color/tinta"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Cartão: feminino (moldura de madeira) -->
        <LinearLayout
            android:id="@+id/cardFeminino"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_moldura"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgFeminino"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:contentDescription="@string/opcao_feminino" />

            <!-- Nome numa faixa de pergaminho -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingVertical="6dp"
                android:gravity="center"
                android:background="@drawable/bg_pergaminho"
                android:text="@string/opcao_feminino"
                android:fontFamily="@font/medieval"
                android:textColor="@color/tinta"
                android:textSize="20sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Assinatura do autor, discreta no rodapé -->
    <TextView
        android:id="@+id/txtAssinatura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/assinatura"
        android:fontFamily="@font/medieval"
        android:textColor="@color/pergaminho"
        android:textSize="19sp"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>