<?xml version="1.0" encoding="utf-8"?>
<!-- Janela de escolha do inimigo: um pergaminho com o título, um cartão por inimigo
     (os cartões são criados pelo código, a partir do enum Inimigo) e o botão de cancelar. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/bg_pergaminho"
    android:orientation="vertical">

    <!-- Cabeçalho: título centralizado e, no canto direito, o botão "?" que abre o Bestiário.
         O título tem um respiro dos dois lados para nunca ficar embaixo do botão. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingHorizontal="36dp"
            android:gravity="center"
            android:text="@string/titulo_escolha_inimigo"
            android:fontFamily="@font/medieval"
            android:textColor="@color/tinta"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnBestiario"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end|top"
            android:background="@drawable/bg_botao_redondo"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="\?"
            android:fontFamily="@font/medieval"
            android:textColor="@color/dourado"
            android:textSize="19sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:contentDescription="@string/descricao_btn_bestiario" />
    </FrameLayout>

    <!-- Os cartões dos inimigos entram aqui -->
    <LinearLayout
        android:id="@+id/listaInimigos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancelar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="32dp"
        android:background="@drawable/bg_madeira"
        android:text="@string/cancelar"
        android:fontFamily="@font/medieval"
        android:textAllCaps="false"
        android:textColor="@color/pergaminho"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>
